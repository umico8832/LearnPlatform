        {
          "label": "A",
          "content": "仅 I"
        },
        {
          "label": "B",
          "content": "仅 II"
        },
        {
          "label": "C",
          "content": "仅 I、II"
        },
        {
          "label": "D",
          "content": "仅 I、III"
        }
      ],
      "correctAnswer": "A",
      "misconceptions": {
        "B": {
          "title": "把连通的边数下界写成严格不等式",
          "explanation": "树是连通图且边数恰好等于顶点数减1，所以II不能要求严格大于。"
        },
        "C": {
          "title": "将至少与严格大于混淆",
          "explanation": "I由每边贡献两个度成立，但树的边数恰在下界，II不一定成立。"
        },
        "D": {
          "title": "把树的叶性质推广到所有连通图",
          "explanation": "三角形连通且各点度为2，不存在度为1的顶点；III对一般连通图不成立。"
        }
      },
      "hints": [
        {
          "level": 1,
          "text": "逐条区分握手计数与连通图可能包含环这两个事实。"
        },
        {
          "level": 2,
          "text": "用一棵树检验边数是否必须严格超出下界，再用一个环检验叶是否必须存在。"
        },
        {
          "level": 3,
          "text": "另取一个四顶点环，分别统计度之和、边数和度为1的顶点，不要把连通图自动当树。"
        }
      ],
      "solution": "每条无向边在两端各贡献1，度之和为 `2m`，I必然正确。树有 `m=n-1`，否定II；三角形所有度为2，否定III，因此只有I。",
