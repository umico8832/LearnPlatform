          "label": "A",
          "content": "仅 I"
        },
        {
          "label": "B",
          "content": "仅 II"
        },
        {
          "label": "C",
          "content": "仅 I、II"
        },
        {
          "label": "D",
          "content": "仅 II、III"
        }
      ],
      "correctAnswer": "D",
      "misconceptions": {
        "A": {
          "title": "把空间占用高误当查找更快",
          "explanation": "较大的装填因子通常使冲突与探测负担增加，不能作为改善平均查找效率的一般方向。"
        },
        "B": {
          "title": "漏掉冲突处理造成的聚集",
          "explanation": "即使初始散列分布相同，不同处理方式仍会影响聚集和后续探测，不能只考虑散列函数。"
        },
        "C": {
          "title": "同时误用装填因子与遗漏聚集",
          "explanation": "I的方向通常不利于查找，III则正是降低额外探测的合理方向，不能只选I、II。"
        }
      },
      "hints": [
        {
          "level": 1,
          "text": "分别考察表的拥挤程度、初始地址分布与后续探测行为。"
