# ============================================================
# AI 题库与错题复习系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ==================== MySQL 配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=learn_platform
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_USER=learn_platform
MYSQL_PASSWORD=your_mysql_password_here

# ==================== JWT 配置 ====================
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_here
JWT_EXPIRATION=604800

# ==================== 后端应用配置 ====================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==================== AI 配置 ====================
# 是否启用 AI 功能（true/false）
AI_ENABLED=false
# AI API 基础地址（OpenAI 兼容接口）
AI_API_BASE_URL=https://api.openai.com/v1
# AI API 密钥（必填，否则 AI 功能不可用）
AI_API_KEY=
# AI 模型名称
AI_MODEL=gpt-3.5-turbo
# AI 请求超时（毫秒）
AI_TIMEOUT=30000
# AI 最大输出 Token 数
AI_MAX_TOKENS=2000

# ==================== Redis 配置（可选） ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== 前端配置 ====================
# 后端 API 地址（开发环境通过 Vite 代理，生产环境通过 Nginx 代理）
VITE_API_BASE_URL=/api

# ==================== 管理员初始账号 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123