# ============================================================
# AI 题库与错题复习系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# ==================== MySQL 配置 ====================
DB_URL="jdbc:mysql://localhost:3306/learn_platform?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true"
DB_USERNAME=root
DB_PASSWORD=change_me

# ==================== JWT 配置 ====================
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_here
JWT_EXPIRATION=604800
AUTH_TOKEN_SECRET=another_secret_at_least_256_bits_for_auth_tokens

# ==================== 认证与邮件 ====================
# Cloudflare Turnstile：Site Key 可进入前端，Secret Key 只能由后端读取
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
FRONTEND_URL=http://localhost
# Google OAuth：客户端密钥只允许后端读取
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/callback/google
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@learnplatform.local
SMTP_AUTH=false
SMTP_STARTTLS=false

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# ==================== 后端应用配置 ====================
SERVER_PORT=8080
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=80
SPRING_PROFILES_ACTIVE=docker

# ==================== AI 配置 ====================
# 是否启用 AI 功能（true/false）
AI_ENABLED=false
# AI API 基础地址（OpenAI 兼容接口）
AI_API_BASE_URL=https://api.openai.com/v1
# AI API 密钥（必填，否则 AI 功能不可用）
AI_API_KEY=
# AI 模型名称
AI_MODEL=gpt-3.5-turbo
# AI 请求超时（毫秒）
AI_TIMEOUT=30000
# AI 最大输出 Token 数
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_TOOLS_SUPPORTED=false
AI_STRUCTURED_OUTPUT_SUPPORTED=false
PRIVATE_EXAM_SOURCE_STORAGE_LIMIT_BYTES=104857600
# 每用户每日 AI 调用次数上限（0 表示不限制）
AI_DAILY_QUOTA=50
# AI 运营提醒站外 webhook 通知（默认关闭；URL 可填入企业微信/飞书/自建网关等地址）
AI_ALERT_WEBHOOK_ENABLED=false
AI_ALERT_WEBHOOK_URL=
AI_ALERT_WEBHOOK_TIMEOUT=5000
# 正式题目 AI 复审建议缓存 TTL
CACHE_TTL_QUESTION_REVIEW_SUGGESTION=30m

# ==================== 监控配置 ====================
# Prometheus 宿主机端口
PROMETHEUS_HOST_PORT=9090
# Grafana 宿主机端口
GRAFANA_HOST_PORT=3000
# Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=admin123
# Loki 宿主机端口
LOKI_HOST_PORT=3100

# ==================== 前端配置 ====================
# 后端 API 地址（开发环境通过 Vite 代理，生产环境通过 Nginx 代理）
VITE_API_BASE_URL=/api
# 前端 AI 同步请求超时（毫秒）；流式接口不依赖该 Axios 超时
VITE_AI_TIMEOUT=120000

# ==================== 本地开发入口 ====================
# dev.py 使用的 Docker 基础服务回环端口
DEV_MYSQL_PORT=13306
DEV_SMTP_PORT=11025
MAILPIT_HOST_PORT=8025
