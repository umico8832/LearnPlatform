      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_sum{application=\"learn-platform\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{application=\"learn-platform\"}[5m])) * 1000)",
          "legendFormat": "{{uri}}",
          "refId": "A"
