      "title": "JVM 堆内存使用率",
      "type": "stat",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"learn-platform\",area=\"heap\"} / jvm_memory_max_bytes{application=\"learn-platform\",area=\"heap\"} * 100",
          "legendFormat": "Heap Usage",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
