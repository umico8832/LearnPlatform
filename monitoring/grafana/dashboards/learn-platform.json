        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "请求速率（按 URI Top 10）",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, sum by (uri) (rate(http_server_requests_seconds_count{application=\"learn-platform\"}[5m])))",
