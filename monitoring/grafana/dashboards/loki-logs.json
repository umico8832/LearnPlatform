{
  "annotations": {
    "list": []
  },
  "description": "Learn Platform - 日志探索面板（Loki）",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": false,
      "title": "Dashboard Links",
      "type": "link",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "日志条数",
            "lineWidth": 1,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "spanNulls": false,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({service=\"learn-platform\"} | json [$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "title": "日志量趋势（按级别）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "axisBorderShow": false,
            "fillOpacity": 50,
            "lineWidth": 1,
            "spanNulls": false,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "count_over_time({service=\"learn-platform\"} |= \"ERROR\" [$__interval])",
          "legendFormat": "ERROR",
          "refId": "A"
        }
      ],
      "title": "ERROR 日志趋势",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "axisBorderShow": false,
            "fillOpacity": 50,
            "lineWidth": 1,
            "spanNulls": false,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "count_over_time({service=\"learn-platform\"} |= \"WARN\" [$__interval])",
          "legendFormat": "WARN",
          "refId": "A"
        }
      ],
      "title": "WARN 日志趋势",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Line" },
            "properties": [
              { "id": "custom.width", "value": 800 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "level" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "ERROR": { "color": "red", "index": 0 } }, "type": "value" },
                  { "options": { "WARN": { "color": "orange", "index": 1 } }, "type": "value" },
                  { "options": { "INFO": { "color": "green", "index": 2 } }, "type": "value" }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 12 },
      "id": 4,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": false,
        "showCommonLabels": false,
        "showTimestamp": true,
        "prettifyLogMessage": false,
        "enableInfiniteScrolling": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "{service=\"learn-platform\"} | json | line_format \"{{.traceId}} | {{.level}} | {{.httpMethod}} {{.httpUri}} {{.httpStatus}} | {{._entry}}\"",
          "refId": "A"
        }
      ],
      "title": "应用日志流（结构化 JSON）",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" },
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({service=\"learn-platform\"} | json [$__range]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "title": "日志级别分布",
      "type": "piechart"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" },
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "editorMode": "code",
          "expr": "topk(10, sum by (httpUri) (count_over_time({service=\"learn-platform\"} | json | httpUri != \"\" [$__range])))",
          "legendFormat": "{{httpUri}}",
          "refId": "A"
        }
      ],
      "title": "Top 10 请求 URI",
      "type": "piechart"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["learn-platform", "logs", "loki"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "数据源",
        "multi": false,
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Shanghai",
  "title": "Learn Platform - 日志探索",
  "uid": "learn-platform-logs",
  "version": 1
}