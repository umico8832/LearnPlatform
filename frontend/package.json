{
  "name": "learn-platform-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/views/admin/QuestionManage.vue\" \"src/views/admin/QuestionGovernanceDrawers.vue\" \"src/views/admin/questionManagePresentation.ts\" \"src/views/admin/useQuestionImportExport.ts\" \"*.{js,json,ts}\"",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots:demo": "node scripts/capture-demo-screenshots.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.8",
    "dompurify": "^3.4.10",
    "echarts": "^5.5.0",
    "element-plus": "^2.6.3",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "happy-dom": "^20.10.3",
    "prettier": "^3.8.1",
    "typescript": "^5.4.5",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.0.11"
  }
}
